# TetraFree — переменные окружения сервера (npm run dev / npm run server).
# Скопируй в .env и экспортируй перед запуском, либо задай в systemd/Docker.

# Почта. Без SMTP письма не уходят в интернет, а показываются в «Dev-почте» на экране входа.
# SMTP_URL=smtps://user:password@smtp.example.com:465     # или smtp://user:pass@host:587 (STARTTLS)
# MAIL_FROM="TetraFree <no-reply@example.com>"

# Публичный адрес приложения — для ссылок в письмах (подтверждение, сброс, приглашение)
# APP_URL=https://tetra.example.com

# Командный хост: слушать снаружи и принимать запросы с этих доменов.
# Диск, shell и git всё равно доступны ТОЛЬКО с localhost.
# HOST=0.0.0.0
# PORT=3001
# TF_ALLOWED_HOSTS=tetra.example.com

# Вход через GitHub / Google (кнопки появятся сами). Callback: $APP_URL/api/auth/oauth/<github|google>/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Где хранятся проекты и база аккаунтов
# TF_ROOT=~/TetraFree/projects
# TF_DATA=~/TetraFree/data
